{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/AcxiomCRM.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/AcxiomCRM.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "ef: update database",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "database", "update", "--project", "${workspaceFolder}/src/AcxiomCRM"],
      "options": { "cwd": "${workspaceFolder}/src/AcxiomCRM" },
      "problemMatcher": []
    }
  ]
}
