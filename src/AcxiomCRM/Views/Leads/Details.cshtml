@model LeadDetailsViewModel
@{
    var l = Model.Lead;
    ViewData["Title"] = l.LeadName;
    var flow = new[] { LeadStatus.New, LeadStatus.Contacted, LeadStatus.Qualified, LeadStatus.Converted };
    var reached = Array.IndexOf(flow, l.Status);
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Leads</a></li><li class="breadcrumb-item active">@l.LeadCode</li></ol></nav>
        <h1>@l.LeadName @Html.StatusBadge(l.Status) @Html.StatusBadge(l.Priority)</h1>
        <p class="subtitle">@(l.CompanyName ?? "—") · @l.Source.Label() · Assigned to @l.AssignedTo?.FullName</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (l.Status == LeadStatus.Qualified)
        {
            <a class="btn btn-success" asp-action="Convert" asp-route-id="@l.LeadId"><i class="bi bi-arrow-right-circle me-1"></i>Convert</a>
        }
        @if (l.Status != LeadStatus.Converted)
        {
            <a class="btn btn-outline-primary" asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@l.LeadId"><i class="bi bi-calendar-plus me-1"></i>Follow-up</a>
        }
        <a class="btn btn-outline-primary" asp-controller="Activities" asp-action="Create" asp-route-leadId="@l.LeadId"><i class="bi bi-activity me-1"></i>Log activity</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@l.LeadId"><i class="bi bi-pencil me-1"></i>Edit</a>
        <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" data-confirm="Delete lead @l.LeadName and its follow-ups/activities?" data-confirm-button="Delete">
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i><span class="visually-hidden">Delete</span></button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="stage-steps mb-3">
            @for (var i = 0; i < flow.Length; i++)
            {
                var css = l.Status == LeadStatus.Lost || l.Status == LeadStatus.Unqualified ? "" : i < reached ? "done" : i == reached ? (flow[i] == LeadStatus.Converted ? "won" : "current") : "";
                <div class="step @css">@flow[i].Label()</div>
            }
            @if (l.Status is LeadStatus.Lost or LeadStatus.Unqualified)
            {
                <div class="step lost">@l.Status.Label()</div>
            }
        </div>
        @if (Model.NextStatuses.Count > 0)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-body-secondary me-1">Move to:</span>
                @foreach (var next in Model.NextStatuses)
                {
                    <form asp-action="ChangeStatus" asp-route-id="@l.LeadId" method="post" class="d-inline"
                          data-confirm="Change status from @l.Status.Label() to @next.Label()?" data-confirm-button="Change status" data-confirm-style="btn-primary">
                        <input type="hidden" name="status" value="@next" />
                        <button class="btn btn-sm @(next is LeadStatus.Lost or LeadStatus.Unqualified ? "btn-outline-danger" : "btn-outline-primary")" type="submit">@next.Label()</button>
                    </form>
                }
            </div>
        }
        else if (l.Status == LeadStatus.Converted)
        {
            <div class="small">Converted on @l.ConvertedDate?.ToString("dd MMM yyyy") to
                @if (l.ConvertedCustomer is not null)
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId">@l.ConvertedCustomer.CustomerName</a>
                }
                else { <span>a customer</span> }.
            </div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Lead information</div>
            <div class="card-body">
                <dl class="detail-list mb-0">
                    <dt>Email</dt><dd>@(l.Email ?? "—")</dd>
                    <dt>Phone</dt><dd>@(l.Phone ?? "—")</dd>
                    <dt>Expected value</dt><dd>@l.ExpectedValue.Money()</dd>
                    <dt>Created</dt><dd>@l.CreatedDate.ToString("dd MMM yyyy")</dd>
                    @if (!string.IsNullOrEmpty(l.Notes))
                    {
                        <dt>Notes</dt><dd class="mb-0" style="white-space:pre-line">@l.Notes</dd>
                    }
                </dl>
            </div>
        </div>
        <partial name="_History" model="Model.History" />
    </div>
    <div class="col-lg-8">
        @if (Model.Opportunities.Count > 0)
        {
            <div class="card mb-3 table-card">
                <div class="card-header">Opportunities from this lead</div>
                <div class="table-responsive"><table class="table align-middle"><tbody>
                @foreach (var o in Model.Opportunities)
                {
                    <tr><td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td><td>@Html.StatusBadge(o.Stage)</td><td class="text-end">@o.Amount.Money()</td></tr>
                }
                </tbody></table></div>
            </div>
        }
        <div class="card mb-3 table-card">
            <div class="card-header">Follow-ups (@Model.FollowUps.Count)</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Date</th><th>Subject</th><th>Status</th><th>Assigned</th></tr></thead>
                    <tbody>
                    @if (Model.FollowUps.Count == 0) { <tr><td colspan="4" class="text-body-secondary">No follow-ups.</td></tr> }
                    @foreach (var f in Model.FollowUps)
                    {
                        <tr class="@(f.IsOverdue ? "row-overdue" : "")">
                            <td class="text-nowrap">@f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@f.Subject</td>
                            <td>@Html.StatusBadge(f.Status)</td>
                            <td>@f.AssignedTo?.FullName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card table-card">
            <div class="card-header">Activities (@Model.Activities.Count)</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th></tr></thead>
                    <tbody>
                    @if (Model.Activities.Count == 0) { <tr><td colspan="4" class="text-body-secondary">No activities logged.</td></tr> }
                    @foreach (var a in Model.Activities)
                    {
                        <tr>
                            <td class="text-nowrap">@a.ActivityDate.ToString("dd MMM yyyy")</td>
                            <td>@a.ActivityType.Label()</td>
                            <td>@a.Subject</td>
                            <td>@Html.StatusBadge(a.Status)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
