@model RolesViewModel
@{ ViewData["Title"] = "Roles & permissions"; }
<div class="page-header">
    <div>
        <h1>Roles &amp; permissions</h1>
        <p class="subtitle">Authorization is enforced on the server for every page, record and API — not only by hiding menu items.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-1"></i>Assign roles to users</a>
</div>
<div class="row g-3 mb-3">
    @foreach (var r in Model.Roles)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">@Roles.Display(r.Name)</h2>
                        <span class="badge text-bg-light border">@r.UserCount user@(r.UserCount == 1 ? "" : "s")</span>
                    </div>
                    <p class="text-body-secondary small mb-0">@r.Scope</p>
                </div>
            </div>
        </div>
    }
</div>
<div class="card table-card">
    <div class="card-header">Permission matrix</div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Module</th><th>Admin</th><th>Manager</th><th>Sales Executive</th></tr></thead>
            <tbody>
            @foreach (var (module, admin, manager, sales) in Model.Matrix)
            {
                string Cell(string v) => v == "No" ? "text-danger" : v == "Full" || v == "All" ? "text-success fw-semibold" : "";
                <tr>
                    <td class="fw-medium">@module</td>
                    <td class="@Cell(admin)">@admin</td>
                    <td class="@Cell(manager)">@manager</td>
                    <td class="@Cell(sales)">@sales</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
