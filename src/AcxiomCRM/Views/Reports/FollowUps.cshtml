@model ReportViewModel<FollowUp>
@{ ViewData["Title"] = Model.Title; var view = ViewBag.View as string; }
<partial name="_ReportHeader" model='(Model.Title, Model.Summary)' />
<div class="card table-card">
    <form method="get" class="filter-bar row g-2 align-items-end" data-autosubmit>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="view">Show</label>
            <select id="view" name="view" class="form-select">
                <option value="">All</option>
                <option value="overdue" selected="@(view == "overdue")">Overdue only</option>
                <option value="upcoming" selected="@(view == "upcoming")">Upcoming only</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="status">Status</label>
            <select id="status" name="status" class="form-select"><option value="">All</option>
                @foreach (var s in Enum.GetValues<FollowUpStatus>()) { <option value="@s" selected="@(Model.Filter.Status == s.ToString())">@s</option> }
            </select>
        </div>
        <partial name="_OwnerFilter" model='(Model.Users, "Assigned to")' />
        <partial name="_DateFilter" model='(Model.Filter, "Date")' />
        <input type="hidden" name="sort" value="@Model.Filter.Sort" />
        <div class="col-md-1"><button class="btn btn-outline-primary w-100" aria-label="Apply"><i class="bi bi-search"></i></button></div>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>@Html.SortHeader("date", "Date")</th><th>@Html.SortHeader("subject", "Subject")</th><th>Type</th><th>Related to</th><th>@Html.SortHeader("status", "Status")</th><th>Assigned</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="6"><partial name="_EmptyState" model="@("No data for these filters.")" /></td></tr> }
            @foreach (var f in Model.Items)
            {
                <tr class="@(f.IsOverdue ? "row-overdue" : "")"><td class="text-nowrap">@f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</td><td>@f.Subject</td><td>@f.FollowUpType</td><td>@f.RelatedTo</td>
                    <td>@Html.StatusBadge(f.Status) @if (f.IsOverdue) { <span class="badge text-bg-danger">Overdue</span> }</td><td>@f.AssignedTo?.FullName</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="px-3 pb-3"><partial name="_Pager" model="Model.Items" /></div>
</div>
