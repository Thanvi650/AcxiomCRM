@model PipelineReportViewModel
@{
    const string title = "Pipeline Report";
    ViewData["Title"] = title;
    var r = Model.Report;
    var summary = new Dictionary<string, string>
    {
        ["Open pipeline"] = r.TotalOpenAmount.Money(),
        ["Weighted pipeline"] = r.TotalWeightedAmount.Money(),
        ["Open deals"] = r.ByOwner.Sum(o => o.OpenCount).ToString()
    };
}
<partial name="_ReportHeader" model="(title, summary)" />
@if (Model.Users.Count > 0)
{
    <form method="get" class="row g-2 align-items-end mb-3" data-autosubmit>
        <partial name="_OwnerFilter" model='(Model.Users, "Owner")' />
    </form>
}
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card table-card h-100">
            <div class="card-header">Stage-wise pipeline</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Stage</th><th class="text-end">Deals</th><th class="text-end">Amount</th><th class="text-end">Weighted</th></tr></thead>
                    <tbody>
                    @foreach (var s in r.ByStage)
                    {
                        <tr><td>@Html.StatusBadge(s.Stage)</td><td class="text-end">@s.Count</td><td class="text-end">@s.Amount.Money()</td><td class="text-end">@s.WeightedAmount.Money()</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card table-card h-100">
            <div class="card-header">Owner-wise pipeline</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Owner</th><th class="text-end">Open deals</th><th class="text-end">Open amount</th><th class="text-end">Weighted</th><th class="text-end">Won</th></tr></thead>
                    <tbody>
                    @if (r.ByOwner.Count == 0) { <tr><td colspan="5"><partial name="_EmptyState" model="@("No opportunities.")" /></td></tr> }
                    @foreach (var o in r.ByOwner)
                    {
                        <tr><td>@o.OwnerName</td><td class="text-end">@o.OpenCount</td><td class="text-end">@o.OpenAmount.Money()</td><td class="text-end">@o.WeightedAmount.Money()</td><td class="text-end text-success">@o.WonAmount.Money()</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
