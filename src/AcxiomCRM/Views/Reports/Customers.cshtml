@model ReportViewModel<Customer>
@{ ViewData["Title"] = Model.Title; }
<partial name="_ReportHeader" model='(Model.Title, Model.Summary)' />
<div class="card table-card">
    <form method="get" class="filter-bar row g-2 align-items-end" data-autosubmit>
        <div class="col-md-3"><label class="form-label small mb-1" for="q">Search</label><input id="q" name="q" value="@Model.Filter.Q" class="form-control" /></div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="status">Status</label>
            <select id="status" name="status" class="form-select"><option value="">All</option>
                @foreach (var s in Enum.GetValues<CustomerStatus>()) { <option value="@s" selected="@(Model.Filter.Status == s.ToString())">@s</option> }
            </select>
        </div>
        <partial name="_OwnerFilter" model='(Model.Users, "Owner")' />
        <partial name="_DateFilter" model='(Model.Filter, "Created")' />
        <input type="hidden" name="sort" value="@Model.Filter.Sort" />
        <div class="col-md-1"><button class="btn btn-outline-primary w-100" aria-label="Apply"><i class="bi bi-search"></i></button></div>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Code</th><th>@Html.SortHeader("name", "Customer")</th><th>@Html.SortHeader("company", "Company")</th><th>@Html.SortHeader("status", "Status")</th><th>Owner</th><th>@Html.SortHeader("created", "Created")</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="6"><partial name="_EmptyState" model="@("No data for these filters.")" /></td></tr> }
            @foreach (var c in Model.Items)
            {
                <tr><td class="text-muted-sm">@c.CustomerCode</td><td><a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId">@c.CustomerName</a></td><td>@c.CompanyName</td><td>@Html.StatusBadge(c.Status)</td><td>@c.AssignedTo?.FullName</td><td>@c.CreatedDate.ToString("dd MMM yyyy")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="px-3 pb-3"><partial name="_Pager" model="Model.Items" /></div>
</div>
