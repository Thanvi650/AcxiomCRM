@model (List<SelectListItem> Users, string Label)
@if (Model.Users.Count > 0)
{
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="assignedTo">@Model.Label</label>
        <select id="assignedTo" name="assignedTo" class="form-select">
            <option value="">Anyone</option>
            @foreach (var u in Model.Users) { <option value="@u.Value" selected="@u.Selected">@u.Text</option> }
        </select>
    </div>
}
