@inject IUserScope Scope
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var fullName = User.FindFirst(AppClaimsPrincipalFactory.FullNameClaim)?.Value ?? User.Identity?.Name;
    var initials = string.Concat((fullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app-shell">
    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Main navigation">
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-mark">A</span>
                <span>Acxiom<strong>CRM</strong></span>
            </a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close menu"></button>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-section">Overview</div>
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

            <div class="nav-section">Sales</div>
            <a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-buildings"></i> Customers</a>
            <a class="nav-link @Active("Leads")" asp-controller="Leads" asp-action="Index"><i class="bi bi-funnel"></i> Leads</a>
            <a class="nav-link @Active("Opportunities", "Index")@Active("Opportunities", "Details")@Active("Opportunities", "Create")@Active("Opportunities", "Edit")" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-briefcase"></i> Opportunities</a>
            <a class="nav-link @Active("Opportunities", "Pipeline")" asp-controller="Opportunities" asp-action="Pipeline"><i class="bi bi-kanban"></i> Sales Pipeline</a>

            <div class="nav-section">Engagement</div>
            <a class="nav-link @Active("FollowUps")" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check"></i> Follow-Ups</a>
            <a class="nav-link @Active("Activities")" asp-controller="Activities" asp-action="Index"><i class="bi bi-activity"></i> Activities</a>

            <div class="nav-section">Insights</div>
            <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Reports</a>

            @if (!Scope.IsSalesExecutive)
            {
                <div class="nav-section">Administration</div>
                <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> @(Scope.IsAdmin ? "Users" : "My Team")</a>
                @if (Scope.IsAdmin)
                {
                    <a class="nav-link @Active("Roles")" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i> Roles &amp; Permissions</a>
                }
                <a class="nav-link @Active("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text"></i> Audit Log</a>
            }
        </nav>
        <div class="sidebar-footer">
            <span class="badge rounded-pill role-pill">@Roles.Display(Scope.RoleName)</span>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                <i class="bi bi-list fs-4"></i>
            </button>
            <form class="topbar-search d-none d-md-flex" asp-controller="Customers" asp-action="Index" method="get" role="search">
                <i class="bi bi-search"></i>
                <input class="form-control" type="search" name="q" placeholder="Search customers by name, email, phone, company…" aria-label="Search customers" />
            </form>
            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="dropdown d-none d-sm-block">
                    <button class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-lg"></i> New</button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" asp-controller="Customers" asp-action="Create"><i class="bi bi-buildings me-2"></i>Customer</a></li>
                        <li><a class="dropdown-item" asp-controller="Leads" asp-action="Create"><i class="bi bi-funnel me-2"></i>Lead</a></li>
                        <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Create"><i class="bi bi-briefcase me-2"></i>Opportunity</a></li>
                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create"><i class="bi bi-calendar-plus me-2"></i>Follow-up</a></li>
                        <li><a class="dropdown-item" asp-controller="Activities" asp-action="Create"><i class="bi bi-activity me-2"></i>Activity</a></li>
                    </ul>
                </div>
                @await Component.InvokeAsync("Notifications")
                <div class="dropdown">
                    <button class="btn btn-user" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                        <span class="avatar">@initials</span>
                        <span class="d-none d-md-inline text-start lh-sm">
                            <span class="d-block fw-semibold small">@fullName</span>
                            <span class="d-block text-body-secondary" style="font-size:.72rem">@Roles.Display(Scope.RoleName)</span>
                        </span>
                        <i class="bi bi-chevron-down small d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><span class="dropdown-item-text small text-body-secondary">@User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content" id="main-content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>

        <footer class="footer">
            <span>© @DateTime.Now.Year AcxiomCRM</span>
            <span class="text-body-tertiary">Signed in as @User.Identity?.Name</span>
        </footer>
    </div>
</div>

<partial name="_ConfirmModal" />

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
