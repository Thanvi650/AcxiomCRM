@model IPagedList
@if (Model.TotalCount > 0)
{
    var first = (Model.PageIndex - 1) * Model.PageSize + 1;
    var last = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);
    var start = Math.Max(1, Model.PageIndex - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div class="small text-body-secondary">Showing @first–@last of @Model.TotalCount</div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Context.Request.WithQuery(("page", (Model.PageIndex - 1).ToString()))" aria-label="Previous">&laquo;</a>
                    </li>
                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Context.Request.WithQuery(("page", p.ToString()))" aria-current="@(p == Model.PageIndex ? "page" : null)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Context.Request.WithQuery(("page", (Model.PageIndex + 1).ToString()))" aria-label="Next">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
