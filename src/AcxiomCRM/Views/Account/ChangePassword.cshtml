@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="page-header">
    <div>
        <h1>Change password</h1>
        <p class="subtitle">Choose a strong password you don't use anywhere else.</p>
    </div>
</div>
<div class="card" style="max-width:560px">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label required"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters with upper- and lower-case letters, a number and a symbol.</div>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <button class="btn btn-primary" type="submit">Update password</button>
            <a class="btn btn-link" asp-controller="Home" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
