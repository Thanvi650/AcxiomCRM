@model PipelineBoardViewModel
@{ ViewData["Title"] = "Sales pipeline"; var returnUrl = Context.Request.Path.ToString(); }
<div class="page-header">
    <div>
        <h1>Sales pipeline</h1>
        <p class="subtitle">Open deals by stage. Won/Lost columns show the last 90 days.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Index"><i class="bi bi-list-ul me-1"></i>List view</a>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New opportunity</a>
    </div>
</div>
<div class="pipeline-board">
    @foreach (var (stage, items) in Model.Columns)
    {
        var next = stage switch
        {
            OpportunityStage.Qualification => OpportunityStage.Proposal,
            OpportunityStage.Proposal => OpportunityStage.Negotiation,
            OpportunityStage.Negotiation => OpportunityStage.Won,
            _ => (OpportunityStage?)null
        };
        <section class="pipeline-col" aria-label="@stage">
            <h2><span>@Html.StatusBadge(stage)</span><span class="text-body-secondary">@items.Count</span></h2>
            <div class="text-muted-sm">@items.Sum(i => i.Amount).Money() · weighted @items.Sum(i => i.WeightedAmount).Money()</div>
            @foreach (var o in items)
            {
                <div class="pipeline-card">
                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold d-block text-truncate">@o.OpportunityName</a>
                    <div class="text-muted-sm text-truncate">@o.Customer?.CustomerName · @o.AssignedTo?.FullName</div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="amount">@o.Amount.Money()</span>
                        <span class="text-muted-sm">@o.Probability% · @((o.ClosedDate ?? o.ExpectedCloseDate).ToString("dd MMM"))</span>
                    </div>
                    @if (next is not null)
                    {
                        <form asp-action="ChangeStage" asp-route-id="@o.OpportunityId" method="post" class="mt-2">
                            <input type="hidden" name="stage" value="@next" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="btn btn-sm btn-light border w-100" type="submit">Move to @next <i class="bi bi-arrow-right"></i></button>
                        </form>
                    }
                </div>
            }
        </section>
    }
</div>
