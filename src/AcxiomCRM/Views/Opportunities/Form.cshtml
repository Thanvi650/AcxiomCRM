@model OpportunityFormViewModel
@{
    var isEdit = Model.OpportunityId is not null;
    ViewData["Title"] = isEdit ? "Edit opportunity" : "New opportunity";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Opportunities</a></li><li class="breadcrumb-item active">@(isEdit ? Model.OpportunityName : "New")</li></ol></nav>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

@if (Model.Customers.Count == 0)
{
    <div class="alert alert-warning">You need at least one customer before creating an opportunity. <a asp-controller="Customers" asp-action="Create">Create a customer</a>.</div>
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.OpportunityId" method="post" novalidate class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="OpportunityName" class="form-label required"></label>
                <input asp-for="OpportunityName" class="form-control" maxlength="150" />
                <span asp-validation-for="OpportunityName"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Stage" class="form-label required"></label>
                <select asp-for="Stage" asp-items="DisplayHelpers.EnumOptions<OpportunityStage>()" class="form-select"></select>
                <span asp-validation-for="Stage"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerId" class="form-label required"></label>
                <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                    <option value="">Select a customer…</option>
                </select>
                <span asp-validation-for="CustomerId"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LeadId" class="form-label"></label>
                <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                    <option value="">None</option>
                </select>
                <span asp-validation-for="LeadId"></span>
            </div>
        </div>
        <div class="form-section-title">Value &amp; forecast</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label required"></label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input asp-for="Amount" class="form-control" type="number" min="0" step="0.01" id="amount" />
                </div>
                <span asp-validation-for="Amount"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Probability" class="form-label required"></label>
                <div class="input-group">
                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" step="1" id="probability" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="Probability"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ExpectedCloseDate" class="form-label required"></label>
                <input asp-for="ExpectedCloseDate" class="form-control" />
                <span asp-validation-for="ExpectedCloseDate"></span>
            </div>
            <div class="col-12">
                <div class="small text-body-secondary">Weighted value (Amount × Probability ÷ 100): <strong id="weighted">—</strong>.
                    Won sets probability to 100%, Lost to 0%.</div>
            </div>
        </div>
        <div class="form-section-title">Other</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Source" class="form-label"></label>
                <input asp-for="Source" class="form-control" maxlength="100" placeholder="e.g. Referral, Website" />
                <span asp-validation-for="Source"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AssignedToId" class="form-label"></label>
                @if (Model.CanChooseOwner)
                {
                    <select asp-for="AssignedToId" asp-items="Model.Users" class="form-select"></select>
                }
                else
                {
                    <input class="form-control" value="You" disabled />
                }
                <span asp-validation-for="AssignedToId"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
                <span asp-validation-for="Notes"></span>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white d-flex gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.OpportunityId">Cancel</a>
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create opportunity")</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var amount = document.getElementById('amount'), prob = document.getElementById('probability'), out = document.getElementById('weighted');
            var fmt = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
            function update() {
                var a = parseFloat(amount.value), p = parseFloat(prob.value);
                out.textContent = isNaN(a) || isNaN(p) ? '—' : fmt.format(a * p / 100);
            }
            amount.addEventListener('input', update); prob.addEventListener('input', update); update();
        })();
    </script>
}
