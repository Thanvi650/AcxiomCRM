@model ActivityListViewModel
@{ ViewData["Title"] = "Activities"; }
<div class="page-header">
    <div>
        <h1>Activities</h1>
        <p class="subtitle">Calls, meetings, emails and tasks logged against customers and leads.</p>
    </div>
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-lg me-1"></i>Log activity</button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-action="Create" asp-route-type="Call"><i class="bi bi-telephone me-2"></i>Call</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-type="Meeting"><i class="bi bi-people me-2"></i>Meeting</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-type="Email"><i class="bi bi-envelope me-2"></i>Email</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-type="Task"><i class="bi bi-check2-square me-2"></i>Task</a></li>
        </ul>
    </div>
</div>
<div class="card table-card">
    <form method="get" class="filter-bar row g-2 align-items-end" data-autosubmit>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="q">Search</label>
            <input id="q" name="q" value="@Model.Filter.Q" class="form-control" placeholder="Subject, customer, lead" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="type">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<ActivityType>())
                {
                    <option value="@t" selected="@(Model.Filter.Type == t.ToString())">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<ActivityStatus>())
                {
                    <option value="@s" selected="@(Model.Filter.Status == s.ToString())">@s</option>
                }
            </select>
        </div>
        @if (Model.Users.Count > 0)
        {
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="assignedTo">Assigned to</label>
                <select id="assignedTo" name="assignedTo" class="form-select">
                    <option value="">Anyone</option>
                    @foreach (var u in Model.Users)
                    {
                        <option value="@u.Value" selected="@u.Selected">@u.Text</option>
                    }
                </select>
            </div>
        }
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="from">Date from</label>
            <input id="from" name="from" type="date" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1" for="to">Date to</label>
            <input id="to" name="to" type="date" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <input type="hidden" name="sort" value="@Model.Filter.Sort" />
        <div class="col-md-1 d-flex gap-1"><button class="btn btn-outline-primary w-100" type="submit" aria-label="Apply filters"><i class="bi bi-search"></i></button><a class="btn btn-link px-1" asp-action="Index">Clear</a></div>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr><th>@Html.SortHeader("date", "Date")</th><th>@Html.SortHeader("type", "Type")</th><th>@Html.SortHeader("subject", "Subject")</th><th>Related to</th><th>Status</th><th>Assigned</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7"><partial name="_EmptyState" model="@("No activities found.")" /></td></tr>
            }
            @foreach (var a in Model.Items)
            {
                var icon = a.ActivityType switch { ActivityType.Call => "bi-telephone", ActivityType.Meeting => "bi-people", ActivityType.Email => "bi-envelope", _ => "bi-check2-square" };
                <tr>
                    <td class="text-nowrap">@a.ActivityDate.ToString("dd MMM yyyy")<div class="text-muted-sm">@a.ActivityDate.ToString("hh:mm tt")</div></td>
                    <td><i class="bi @icon me-1"></i>@a.ActivityType</td>
                    <td>@a.Subject @if (!string.IsNullOrEmpty(a.Description)) { <div class="text-muted-sm text-truncate" style="max-width:280px">@a.Description</div> }</td>
                    <td>
                        @if (a.Customer is not null) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId">@a.Customer.CustomerName</a> }
                        @if (a.Lead is not null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId">@a.Lead.LeadName</a> }
                        @if (a.Customer is null && a.Lead is null) { <span class="text-body-tertiary">—</span> }
                    </td>
                    <td>@Html.StatusBadge(a.Status)</td>
                    <td>@a.AssignedTo?.FullName</td>
                    <td class="text-end text-nowrap">
                        @if (a.Status == ActivityStatus.Planned)
                        {
                            <form asp-action="Complete" asp-route-id="@a.ActivityId" method="post" class="d-inline"
                                  data-confirm="Mark &quot;@a.Subject&quot; as completed?" data-confirm-button="Complete" data-confirm-style="btn-success">
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button class="btn btn-sm btn-success" title="Complete"><i class="bi bi-check-lg"></i><span class="visually-hidden">Complete</span></button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.ActivityId"><i class="bi bi-pencil"></i><span class="visually-hidden">Edit</span></a>
                        <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" class="d-inline" data-confirm="Delete this activity?" data-confirm-button="Delete">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i><span class="visually-hidden">Delete</span></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="px-3 pb-3"><partial name="_Pager" model="Model.Items" /></div>
</div>
